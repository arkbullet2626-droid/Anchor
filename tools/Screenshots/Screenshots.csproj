<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders Anchor's real tray menu and Settings window to PNGs for the website.
       Runs on a clean Windows CI machine, so no personal windows or names appear. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>..\..\src\Anchor\app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Anchor\Anchor.csproj" />
  </ItemGroup>

</Project>
